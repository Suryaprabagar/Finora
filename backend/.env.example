# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite is the local runtime database (no PostgreSQL or Railway required).
DATABASE_URL=sqlite+aiosqlite:///./finora.db

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=finora-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ─── App ──────────────────────────────────────────────────────────────────────
PROJECT_NAME=Finora

# ─── Google Drive Persistence (opt-in) ────────────────────────────────────────
# Set to true after completing Google Drive setup (see README.md for instructions).
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT=Finora
# Path to the OAuth2 credentials file downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Path where the OAuth2 token will be stored after first authentication.
GOOGLE_TOKEN_FILE=.finora/token.json

# ─── Persistence Tuning ───────────────────────────────────────────────────────
# Maximum numbered permanent versions to retain in Google Drive.
MAX_VERSIONS=5
# Autosave interval in seconds (updates current/ state, does not create new versions).
AUTOSAVE_INTERVAL=300

# ─── Local Cache ──────────────────────────────────────────────────────────────
FINORA_CACHE_DIR=.finora
